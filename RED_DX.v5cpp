{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\nmotor leftMotorA = motor(PORT11, ratio18_1, true);\n\nmotor leftMotorB = motor(PORT12, ratio18_1, false);\n\nmotor leftMotorC = motor(PORT13, ratio18_1, true);\n\nmotor rightMotorA = motor(PORT16, ratio18_1, false);\n\nmotor rightMotorB = motor(PORT17, ratio18_1, true);\n\nmotor rightMotorC = motor(PORT18, ratio18_1, false);\n\ncontroller Controller1 = controller(primary);\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\n\n\nvoid vexcodeInit() {\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n\n#pragma endregion VEXcode Generated Robot Configuration\n#include <cmath>\n#include <algorithm>\n\n// Robot configuration code.\n\nmotor leftMotorA = motor(PORT11, ratio18_1, false);\nmotor leftMotorB = motor(PORT12, ratio18_1, true);\nmotor leftMotorC = motor(PORT13, ratio18_1, false);\nmotor rightMotorA = motor(PORT16, ratio18_1, true);\nmotor rightMotorB = motor(PORT17, ratio18_1, false);\nmotor rightMotorC = motor(PORT18, ratio18_1, true);\nmotor_group leftDrive = motor_group(leftMotorA, leftMotorB, leftMotorC);\nmotor_group rightDrive = motor_group(rightMotorA, rightMotorB, rightMotorC);\n\n\ninertial giro = inertial(PORT20);\n\ndigital_out stake = digital_out(Brain.ThreeWirePort.F);\ndigital_out bracci = digital_out(Brain.ThreeWirePort.H);\ndigital_out cambio = digital_out(Brain.ThreeWirePort.G);\ndigital_out stopper = digital_out(Brain.ThreeWirePort.E);\ndigital_out alliner = digital_out(Brain.ThreeWirePort.D);\ndigital_out block = digital_out(Brain.ThreeWirePort.C);\nrotation leftRotation(PORT11);\nrotation rightRotation(PORT10);\n\n\n\n\n\nmotor rampa = motor(PORT4, ratio18_1, true);\n\nmotor aspirazione = motor(PORT18, ratio18_1, false);\n\noptical Optical19 = optical(PORT19);\n\n\ncontroller Controller1 = controller(primary);\ncontroller Controller2 = controller(partner);\n\n\nvoid resetEncoders() {\n    rampa.setPosition(-128, degrees);\n}\ndouble exponentialCurveFactor = 2;  \nint maxTurnSpeed = 80;\n\nbool toggleStateX = false;\nbool rampRunning = false;\n\n\nfloat kV = 1.0f;\nfloat kA = 0.008f;\ndouble loopDelay = 5;\n\nstatic constexpr float speedAlpha = 0.5f;\n/********************************************************************************************/\n// Parametri PID e tarabili\n\n// PID per rotazione\ndouble kP_turn = 0.62;\ndouble kI_turn = 0.0001;\ndouble kD_turn = 0.022;\n\n// PID per movimento lineare\ndouble kP = 0.06;\ndouble kI = 0.014;\ndouble kD = 0.02;\n\n// Parametri per profili di velocità e decelerazione\nconst double accelFraction = 0.08;\nconst double decelFraction = 0.22;\nconst double a_log = 2.2; \nconst double c_log = 0.6;\n\n// Parametri per fusione sensori: peso del giroscopio e odometria\ndouble GYRO_WEIGHT = 0.7;\ndouble ODO_WEIGHT = 0.3;\nconst double ODO_K = 0.08;\n\n// Filtri low-pass per l'odometria e per la variazione di velocità\nconst double alpha = 0.1;         // Filtro sull'errore odometrico\n\n\nint t=0;\n\n\n// Soglie per il reset dell'integrale\nconst double errorResetThreshold = 0.1;\n\n/********************************************************************************************/\n// Funzione logistica per il profilo S-curve\ninline float logistic(float x) {\n  return 1.0f / (1.0f + expf(-a_log * (x - c_log)));\n}\n/********************************************************************************************/\n// Funzione di rotazione \"gira\" che usa un controllo PID migliorato e dt dinamico\nvoid gira(float targetAngle) {\n  // PID params\n\n  const float errorDead = 2.5f;\n  const float errorReset = 1.0f;\n  const int stableThreshold = 80; // ms\n\n  float integral = 0.0f;\n  float prevError = 0.0f;\n  int stableTime = 0;\n  int elapsed = 0;\n\n  while (true) {\n    float curr = giro.rotation(degrees);\n    float err = targetAngle - curr;\n    if (fabsf(err) < errorDead) {\n      err = 0.0f;\n      stableTime += loopDelay;\n    } else {\n      stableTime = 0;\n    }\n    if (fabsf(err) < errorReset) integral = 0.0f;\n    else integral = fmaxf(-20.0f, fminf(20.0f, integral + err));\n    float deriv = err - prevError;\n    prevError = err;\n\n    float out = kP_turn * err + kI_turn * integral + kD_turn * deriv;\n    leftDrive.spin(forward,  out, percent);\n    rightDrive.spin(forward, -out, percent);\n\n    wait(loopDelay, msec);\n    elapsed += loopDelay;\n    if (stableTime >= stableThreshold || elapsed >= 10000) break;\n  }\n\n  leftDrive.stop();\n  rightDrive.stop();\n  wait(100, msec);\n}\n\n\n\nenum class Dir { Forward, Reverse };\n\nvoid moveDistance(float dis, float targetAngle, float minSpd, float maxSpd, Dir dir) {\n  // Reset encoders & stopping mode\n  leftDrive.setPosition(0, degrees);\n  rightDrive.setPosition(0, degrees);\n  leftRotation.setPosition(0, degrees);\n  rightRotation.setPosition(0, degrees);\n  leftDrive.setStopping(hold);\n  rightDrive.setStopping(hold);\n\n  // Distance calibration\n  dis /= 0.425f;\n  float initPos     = 0.5f * (leftRotation.position(degrees) - rightRotation.position(degrees));\n  float logisticSt  = logistic(1.0f);\n  float logisticEnd = logistic(0.0f);\n\n  float integral = 0.0f;\n  float prevErr   = 0.0f;\n  float filtOdo   = 0.0f;\n  float lastSpd   = maxSpd;\n\n  while (true) {\n    // Compute traveled distance\n    float currPos = 0.5f * (leftRotation.position(degrees) - rightRotation.position(degrees));\n    float traveled = (dir == Dir::Forward)\n                    ? (currPos - initPos)\n                    : fabsf(currPos - initPos);\n    traveled = fmaxf(0.0f, traveled);\n    float progress = fminf(1.0f, traveled / dis);\n\n    // Speed profiling (accel/decel)\n    float targetSpd;\n    if (progress < accelFraction) {\n      float p  = progress / accelFraction;\n      float af = (logisticSt - logistic(1.0f - p)) / (logisticSt - logisticEnd);\n      targetSpd = minSpd + (maxSpd - minSpd) * af;\n    } else if (progress > 1.0f - decelFraction) {\n      float p  = (progress - (1.0f - decelFraction)) / decelFraction;\n      float df = (logistic(p) - logisticEnd) / (logisticSt - logisticEnd);\n      float t  = maxSpd - (maxSpd - minSpd) * df;\n      targetSpd = speedAlpha * t + (1.0f - speedAlpha) * lastSpd;\n    } else {\n      targetSpd = maxSpd;\n    }\n\n    // Sensor fusion (gyro + odometry)\n    float gyroErr = targetAngle - giro.rotation(degrees);\n    float odoErr  = (-rightRotation.position(degrees) - leftRotation.position(degrees)) * ODO_K;\n    filtOdo = alpha * odoErr + (1.0f - alpha) * filtOdo;\n    float err   = GYRO_WEIGHT * gyroErr + ODO_WEIGHT * filtOdo;\n\n    // PID update\n    if (fabsf(err) < errorResetThreshold) {\n      integral = 0.0f;\n    } else {\n      integral = fmaxf(-50.0f, fminf(50.0f, integral + err));\n    }\n    float deriv = err - prevErr;\n    prevErr     = err;\n    float pidOut = kP * err + kI * integral + kD * deriv;\n\n    // Feed-forward\n    float accel = (targetSpd - lastSpd) / (loopDelay / 1000.0f);\n    float ff    = kV * targetSpd + kA * accel;\n    lastSpd     = targetSpd;\n\n    // Motor commands\n    float lcmd = ff + ((dir == Dir::Forward) ? pidOut : -pidOut);\n    float rcmd = ff + ((dir == Dir::Forward) ? -pidOut : pidOut);\n    leftDrive.spin((dir == Dir::Forward) ? forward : reverse, lcmd, percent);\n    rightDrive.spin((dir == Dir::Forward) ? forward : reverse, rcmd, percent);\n\n    if (traveled >= dis) break;\n    vex::task::sleep(loopDelay);\n  }\n\n  leftDrive.stop();\n  rightDrive.stop();\n  vex::task::sleep(200);\n}\n\n// Convenience wrappers\ninline void Forward(float d, float a, float mi, float ma) {\n  moveDistance(d, a, mi, ma, Dir::Forward);\n}\n\ninline void Backward(float d, float a, float mi, float ma) {\n  moveDistance(d, a, mi, ma, Dir::Reverse);\n}\n\n\nint ringDetectionTask() {\n    while (true) {\n                Optical19.setLightPower(100, percent);\n        \n          if (Optical19.color() == blue && Optical19.isNearObject()) {\n            int currentPosition = rampa.position(degrees);\n            int counter = currentPosition/532.49;\n            counter++;\n\n            double targetPosition = counter* 532.49;\n            while (rampa.position(degrees) < targetPosition) {\n                rampa.spin(forward);\n            }\n            rampa.setStopping(hold);\n            rampa.spinFor(reverse, 100, degrees);\n            rampa.setVelocity(100, percent);\n            rampa.spin(forward);\n        }\n     \n    }\n\n    \n    return 0;\n}\n\nint cinghiadetTask() {\n  \n  while(1){}\n      if(rampa.velocity(percent)<= 20){\n        Controller1.Screen.clearScreen();\n        rampa.setTimeout(400,msec);\n        rampa.spinFor(reverse,120,degrees);\n        rampa.setTimeout(400,msec);\n        rampa.setStopping(coast);\n        rampa.stop();\n        rampa.setVelocity(100,percent);\n        rampa.spin(forward);\n        wait(100,msec);\n      }\n    \n  }\n\n\n\n\n\n\n\n\nint ondriver_drivercontrol() {\n  vex::task ringTask(ringDetectionTask);\n  int counter = 0;\n\n  resetEncoders(); // Reset degli encoder all'inizio\n\n  rampa.setVelocity(100,percent);\n  aspirazione.setVelocity(100,percent);\n  rampa.spin(forward);\n\n  \n  rampa.setVelocity(100,percent);\n  leftDrive.setStopping(brake);\n  rightDrive.setStopping(brake);\n  aspirazione.setVelocity(100,percent);\n  aspirazione.spin(forward);\n  rampa.spin(forward);\n\n    while (1) {\n        Optical19.setLightPower(100, percent);\n\n    // 1) Leggi input e gestisci sovrascrittura Controller2\nint forwardInput = Controller1.Axis3.position();\nint turnInput    = Controller1.Axis1.position();\nif (std::abs(Controller2.Axis3.position()) > 5 ||\n    std::abs(Controller2.Axis1.position()) > 5) {\n  forwardInput = Controller2.Axis3.position();\n  turnInput    = Controller2.Axis1.position();\n}\n\n// 2) Applica la curva esponenziale ai due assi, normalizzando in [-1, 1]\ndouble forwardPct = std::pow(std::abs(forwardInput) / 100.0, exponentialCurveFactor);\nif (forwardInput < 0) forwardPct = -forwardPct;\n\ndouble turnPct = std::pow(std::abs(turnInput) / 100.0, exponentialCurveFactor);\nif (turnInput < 0) turnPct = -turnPct;\n\n// 3+4) Se non stai spingendo in avanti, fallo pivotare sul posto,\n//       altrimenti usa il mixing a curvatura\ndouble leftPct, rightPct;\nif (forwardPct == 0.0) {\n  // pivot in place\n  leftPct  =  turnPct;\n  rightPct = -turnPct;\n} else {\n  // curvature drive\n  double curvature = turnPct * std::abs(forwardPct);\n  leftPct  = forwardPct + curvature;\n  rightPct = forwardPct - curvature;\n}\n\n// 5) Clampi manualmente in [-1, 1]\nif (leftPct  >  1.0) leftPct  =  1.0;\nif (leftPct  < -1.0) leftPct  = -1.0;\nif (rightPct >  1.0) rightPct =  1.0;\nif (rightPct < -1.0) rightPct = -1.0;\n\n// 6) Applica al robot (riporta in percentuale 0–100)\nleftDrive.setVelocity(leftPct  * 100.0, percent);\nrightDrive.setVelocity(rightPct * 100.0, percent);\n\nleftDrive.spin(forward);\nrightDrive.spin(forward);\n\n\n        if (Controller1.ButtonY.pressing()) {\n            while(!Controller1.ButtonY.pressing());\n            toggleStateX = !toggleStateX;\n            if (toggleStateX) {\n                rampa.setMaxTorque(100, percent);\n                rampa.setVelocity(100, percent);\n                rampa.spin(forward);\n                aspirazione.setMaxTorque(100, percent);\n                aspirazione.setVelocity(100, percent);\n                aspirazione.spin(forward);\n                rampRunning = true;\n            } else {\n                rampa.stop();\n                aspirazione.stop();\n                rampRunning = false;\n            }\n            wait(300,msec);\n        }\n\n        if(Controller1.ButtonA.pressing()){\n            alliner = !alliner;\n            wait(300,msec);\n          }\n        if (Controller1.ButtonR1.pressing()) {\n            stake = !stake;\n            Controller1.Screen.clearScreen();\n            wait(10,msec);\n            Controller1.Screen.setCursor(1, 1);\n            Controller1.Screen.print(\"Stake: %s\", stake.value() ? \"OFF\" : \"ON\");\n            wait(300, msec);\n        }\n        while (Controller1.ButtonB.pressing()) {\n          t+=10;\n          wait(10,msec);\n          \n          if(t>=1000) {\n            block = 1;\n            wait(1000, msec);\n          }\n          if(!Controller1.ButtonB.pressing()) {\n            t=0;\n            break;\n          }\n        }\n\n        if (Controller2.ButtonR1.pressing() || Controller2.ButtonR2.pressing()) {\n            bracci = !bracci;\n            wait(300, msec);\n        }\n\n        if (Controller2.ButtonL2.pressing() || Controller2.ButtonL1.pressing()) {\n            stopper = !stopper;\n            wait(300, msec);\n        }\n        if (Controller2.ButtonDown.pressing()) {\n            cambio = !cambio;\n            Controller2.Screen.clearScreen();\n            wait(10,msec);\n            Controller2.Screen.setCursor(1, 1);\n            Controller2.Screen.print(\"Cambio: %s\", cambio.value() ? \"OFF\" : \"ON\");\n            wait(300, msec);\n        }\n\n\n        wait(20, msec);\n    }\n}\n\nvex::competition Competition;\nvoid VEXcode_driver_task() {\n    vex::task driveTask(ondriver_drivercontrol);\n    while (Competition.isDriverControl() && Competition.isEnabled()) {\n        this_thread::sleep_for(10);\n    }\n    driveTask.stop();\n}\n\n\nvoid VEXcode_auton_task() {\n  \n  \n  resetEncoders();\n  \n  rampa.setVelocity(100, percent);\n  aspirazione.setVelocity(100,percent);\n  \n  Backward(1000,5,5,40);\n  stake.set(true);\n  wait(500,msec);\n  rampa.spin(forward);\n  wait(200,msec);\n  gira(-80);\n  wait(100,msec);\n  aspirazione.spin(forward);\n  rampa.stop();\n  stake.set(false);\n  Forward(540,-80,10,30);\n  wait(100,msec);\n  aspirazione.stop();\n \n  \n  gira(0);\n\n  Backward(410,-10,5,20);\n  stake.set(true);\n  wait(500,msec);\n  rampa.spin(forward);\n  Forward(600,0,10,100);\n  gira(180);\n\n\n\n  \n \n\n\n    while(1){\n      wait(100,msec);\n    }\n}\n\nint main() {\n  \n    \n\n    // Inizializzazione di VEX Competition\n    vex::competition Competition;\n    vex::competition::bStopTasksBetweenModes = false;\n\n// Inizializzazione sensori e motori\n    wait(2,seconds);\n    \n    Controller1.rumble(rumbleLong);\n    wait(1,seconds);\n    cambio = 1;\n\n    \n    wait(2000,msec);\n    \n    giro.calibrate();\n    \n    while(giro.isCalibrating()){\n      Controller1.rumble(rumbleShort);\n    }\n    wait(1,seconds);\n    resetEncoders();\n    giro.setRotation(0, degrees);\n    giro.setHeading(0, degrees);\n\n    \n    \n\n    // Impostazione modalità autonome e driver control\n    Competition.autonomous([] { VEXcode_auton_task(); });\n    Competition.drivercontrol([] { VEXcode_driver_task(); });\n\n    // Loop principale per evitare la chiusura del programma\n    while (true) {\n        wait(100, msec);\n    }\n}","textLanguage":"cpp","robotConfig":[{"port":[11],"name":"leftMotorA","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"}},{"port":[12],"name":"leftMotorB","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"}},{"port":[13],"name":"leftMotorC","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"}},{"port":[16],"name":"rightMotorA","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"}},{"port":[17],"name":"rightMotorB","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse","gear":"ratio18_1"}},{"port":[18],"name":"rightMotorC","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1"}},{"port":[],"name":"Controller1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"}}],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.61.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}